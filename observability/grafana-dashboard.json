{
  "title": "quiz-service",
  "uid": "quiz-service",
  "tags": ["quiz", "sqlite"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / s (by route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "HTTP latency p50 / p95 / p99 (graphql)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/graphql\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/graphql\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/graphql\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Write transactions: commits vs retries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "rate(tx_commits_total[1m])",
          "legendFormat": "commits/s ({{mode}})"
        },
        {
          "expr": "rate(tx_retries_total[1m])",
          "legendFormat": "retries/s ({{mode}})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Transaction duration p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tx_duration_seconds_bucket[5m])))",
          "legendFormat": "tx p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tx_duration_seconds_bucket[5m])))",
          "legendFormat": "tx p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Attempts graded / s",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "rate(attempts_submitted_total[5m]) * 60",
          "legendFormat": "per minute"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP 5xx errors / s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    }
  ]
}
